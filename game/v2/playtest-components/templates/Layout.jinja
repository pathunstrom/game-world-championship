{#def cards, height, width, row_height, row_width #}

<html lang="en">
<head>
  <title>Generated Cards</title>
  <style>
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
        align-content: center;
    }

    body {
        width: {{ width }}px;
        height: {{ height }}px;
        display: grid;
        grid-template-rows: repeat(7, {{ row_height }}px);
        grid-template-columns: repeat(10, {{ row_width }}px);
    }

    .last {
        grid-column: -2;
        grid-row: -2;
        background: #512258;
    }

    .card {
      padding: 0.5em;
      gap:0.5em;
      border: solid 3px black;
      display: grid;
      grid-template-columns: repeat(6, 1fr);
      grid-template-rows: repeat(8, 1fr);
      text-align: center;
      overflow: hidden;

      .cost {
        font-size: 80px;
        grid-column: 1;
        grid-row: 1;
        border: 6px solid black;
        border-radius: 50%;
      }

      h2 {
        font-size: 75px;
        grid-column: 2/7;

      }

      h2.long {
          font-size: 37px;
      }

      .card-type {
          grid-column: 2/6;
          grid-row: 2;
          font-size: 40px;
      }

      .attack.value, .defense.value {
          grid-row: 7/9;
          font-size: 160px;
      }

      .defense.value {
          grid-column: 5/7;
      }

      .attack.value {
          grid-column: 1/3;
      }

      .attack.label, .defense.label {
          grid-row: 6;
          font-size: 75px;
      }

      .attack.label {
          grid-column: 1;
      }

      .defense.label {
          grid-column: 5;
      }

      .charge.label, .see.label, .keep.label {
        grid-column: 1/5;
        text-align: left;
        font-size: 75px;
        padding-left: 1em;
      }

      .charge.value, .see.value, .keep.value {
          font-size: 75px;
      }

      .charge.label, .charge.value {
          grid-row: 5;
      }

      .see.label, .see.value {
          grid-row: 6;
      }

      .keep.label, .keep.value {
          grid-row: 7;
      }
    }

  </style>
</head>
<body>
  {%- for card in cards -%}
  <Card :card="card"></Card>
  {%- endfor -%}
  <Concealed class="last"></Concealed>
</body>
</html>